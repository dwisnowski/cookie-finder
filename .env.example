# Optional. Quick tunnel (default) needs no secrets — free *.trycloudflare.com.
# Used only if you later switch to a named Zero Trust tunnel + custom hostname.

# Cloudflare Zero Trust → Networks → Tunnels → Create → copy install token
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Fixed public hostname (named tunnels). Quick tunnel ignores this.
# CLOUDFLARE_TUNNEL_URL=https://cookie-finder.example.com/
