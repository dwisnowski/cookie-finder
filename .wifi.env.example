# Copy to .wifi.env and fill in real credentials (.wifi.env is gitignored).
# Used by: make on-the-pi-wifi-configure-clients

WIFI_HOME_SSID=HSH-5G
WIFI_HOME_PSK=replace-with-home-wifi-password
WIFI_HOME_PRIORITY=100

WIFI_HOTSPOT_SSID=Ghostwire
WIFI_HOTSPOT_PSK=replace-with-phone-hotspot-password
WIFI_HOTSPOT_PRIORITY=50
