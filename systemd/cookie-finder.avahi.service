<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertise Cookie Finder HTTP/HTTPS for mDNS clients (cookie-finder.local). -->
<service-group>
  <name replace-wildcards="yes">Cookie Finder on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
  </service>
  <service>
    <type>_https._tcp</type>
    <port>443</port>
  </service>
</service-group>
