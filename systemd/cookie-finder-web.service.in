[Unit]
Description=Cookie Finder web server
Documentation=file://@REPO_ROOT@/docs/usage/running.md
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONPATH=@REPO_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=COOKIE_FINDER_TLS_DIR=@TLS_DIR@
# Bind privileged HTTP/HTTPS ports (works even if User= is added later).
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=@PYTHON@ -u @REPO_ROOT@/main.py --web --host @WEB_HOST@ --port @WEB_PORT@ --https-port @WEB_HTTPS_PORT@ --ssl-certfile @TLS_DIR@/cert.pem --ssl-keyfile @TLS_DIR@/key.pem
Restart=on-failure
RestartSec=2

# Soft stop, then hard kill if needed
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
